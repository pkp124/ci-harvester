# CI Harvester Configuration
# Copy this file to .env and update with your values

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://ci_harvester:password@localhost:5432/ci_harvester

# Connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# =============================================================================
# Jenkins Configuration
# =============================================================================
JENKINS_URL=https://jenkins.example.com
JENKINS_USERNAME=ci-harvester
JENKINS_API_TOKEN=your-api-token-here

# Optional: Filter jobs by regex pattern
JENKINS_JOB_FILTER=.*

# Maximum folder depth to search
JENKINS_FOLDER_DEPTH=3

# Maximum builds to collect per job
JENKINS_MAX_BUILDS=100

# SSL verification (set to false for self-signed certs)
JENKINS_VERIFY_SSL=true

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# API key for authentication (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_KEY=your-api-key-here

# Rate limiting
API_RATE_LIMIT=100/minute

# CORS origins (comma-separated)
API_CORS_ORIGINS=http://localhost:3000,https://dashboard.example.com

# =============================================================================
# Airflow Configuration
# =============================================================================
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://airflow:airflow@localhost:5432/airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=your-webserver-secret-here

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Data Retention (days)
# =============================================================================
RETENTION_TEST_RESULTS=365
RETENTION_BUILD_LOGS=90
RETENTION_BUILDS=730

# =============================================================================
# Optional: Alerting
# =============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# PAGERDUTY_API_KEY=your-pagerduty-key
# ALERT_EMAIL=team@example.com

# =============================================================================
# Optional: External Secrets (Vault, AWS Secrets Manager)
# =============================================================================
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=your-vault-token
# AWS_REGION=us-east-1
# AWS_SECRETS_PREFIX=ci-harvester/
